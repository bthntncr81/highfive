  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String // "Bronze Kutu"
  description String?
  emoji       String   @default("📦")
  // Açmak için harcanacak puan
  pointsCost  Int
  // Prize slices (Spin Wheel ile aynı yapı)

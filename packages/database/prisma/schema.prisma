// ==================== MOBILE PUSH NOTIFICATIONS ====================

model DeviceToken {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  token      String   @unique // ExponentPushToken[xxx]
  platform   String // ios | android
  customerId String? // Customer app cihazları
  userId     String? // POS/Kitchen/Courier (staff) cihazları
  appType    String? // customer | pos | kitchen | courier
  deviceId   String? // App'in kendi ürettiği UUID
  appVersion String?
  locale     String?
  isActive   Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([userId])
  @@index([appType])
  @@index([token])
  @@index([isActive])
  @@index([tenantId])
}

model PushNotification {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title           String
  body            String
  data            Json? // { campaignId, productId, route, ... }
  imageUrl        String?
  campaignId      String?
  targetType      String   @default("ALL") // ALL, VERIFIED, CUSTOMER, DEVICE, SEGMENT
  targetIds       String[] @default([]) // hedef listesi (CUSTOMER için Customer.id)
  // Behavior segmentation kriterleri (targetType=SEGMENT için)
  // Örn: { menuItemIds: ['x'], dayOfWeek: 0, lastNDays: 30 }
  segmentCriteria Json?

  // Recurring (kişiye özel zamanlanmış push'lar için)
  // null = tek seferlik, scheduledAt'taki saatte gider
  // Örn: { type: 'WEEKLY', dayOfWeek: 0, hour: 18, minute: 0 }
  //      { type: 'DAILY', hour: 12 }
  //      { type: 'MONTHLY', dayOfMonth: 1, hour: 9 }
  recurrence Json?
  // Her recurring tetiklemede son ne zaman gönderildiğini takip et (idempotency)
  lastSentAt DateTime?

  // Stats
  sentCount      Int @default(0)
  deliveredCount Int @default(0)
  failedCount    Int @default(0)
  openCount      Int @default(0)

  status      String    @default("DRAFT") // DRAFT, SCHEDULED, SENDING, SENT, FAILED, RECURRING
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([campaignId])
  @@index([scheduledAt])
  @@index([tenantId])
}

// ==================== LOYALTY PROGRAMS (genişletilmiş sadakat) ====================
// 12+ farklı program türü tek model üzerinden — config JSON ile esneklik
//
// Type değerleri:
// - BASIC_POINTS: klasik puan sistemi (mevcut Customer.totalPoints — sadece kontrol için kullanılır)
// - STAMP_CARD: "10 X al, 11.si bedava" — ürün/kategori bazlı damga
// - BIRTHDAY: doğum gününde otomatik kupon/indirim
// - WELCOME: ilk siparişe özel ödül
// - REFERRAL: arkadaş davet sistemi (Customer.referralCode kullanılır)
// - MILESTONE: N. siparişte özel ödül
// - STREAK: N kez üst üste sipariş
// - CASHBACK: %X harcamanın wallet'a (Customer.cashbackBalance)
// - PRODUCT_VIP: belirli ürün/kategoriyi N kere alana özel
// - HAPPY_HOUR_POINTS: belirli saatlerde 2x puan
// - SOCIAL: sosyal medya/yorum karşılığı puan
// - TIER_DISCOUNT: tier'a göre sabit % indirim (mevcut LoyaltyTier'i destekler)

model LoyaltyProgram {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        String // Yukarıdaki türlerden biri
  name        String // "Pizza Damga Kartı", "Doğum Günü Sürprizi"
  description String?
  icon        String? // Emoji veya url
  color       String? // Tema rengi (#bb1e10)
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  // Tüm türler için esnek config — anlamı türe göre değişir
  // Örnek STAMP_CARD: { stampsRequired: 10, rewardType: 'FREE_ITEM', rewardItemId: 'x', rewardValue: 0 }
  // Örnek BIRTHDAY: { discountPercent: 20, freeItemId: 'tatli', daysBeforeBirthday: 0, validDays: 7 }
  // Örnek WELCOME: { discountPercent: 25, bonusPoints: 100, freeItemId: 'icecek' }
  // Örnek REFERRAL: { referrerPoints: 100, refereeDiscount: 15, minOrderForReward: 50 }
  // Örnek MILESTONE: { milestones: [{ orderCount: 5, discountPercent: 20 }, { orderCount: 10, freeItemId: 'pizza' }] }
  // Örnek STREAK: { period: 'WEEKLY', requiredCount: 5, bonusPoints: 100 }
  // Örnek CASHBACK: { cashbackPercent: 5, maxPerOrder: 50 }
  // Örnek PRODUCT_VIP: { trackedItemIds: ['x'], requiredCount: 20, rewardItemId: 'y' }
  // Örnek HAPPY_HOUR_POINTS: { startHour: 14, endHour: 17, multiplier: 2 }
  config Json

  // Tier bazlı override — Bronze/Silver/Gold/Platinum farklı parametre
  // Örnek: { 'tier-id-1': { stampsRequired: 8 }, 'tier-id-2': { stampsRequired: 5 } }
  tierConfig Json?

  // Hedef ürün / kategori (opsiyonel — STAMP_CARD, PRODUCT_VIP için)
  // Bu ürünleri/kategorileri alınca damga/sayaç tetiklenir (ALINAN ÜRÜNLER)
  applicableMenuItemIds String[] @default([])
  applicableCategoryIds String[] @default([])

  // Ödül olarak verilebilecek ürünler — çoklu seçim (VERİLEN ÜRÜNLER)
  // Damga dolduğunda buradaki ürünlerden biri (veya hepsi) bedava verilebilir
  rewardMenuItemIds String[] @default([])
  rewardCategoryIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress CustomerLoyaltyProgress[]
  claims   LoyaltyClaim[]

  @@index([type])
  @@index([isActive])
  @@index([tenantId])
}

// Müşterinin sadakat programı için yaptığı manuel doğrulamalı talep:
// Google review / Instagram story gibi ödüller için ekran görüntüsü yükler,
// admin POS web'den inceleyip onaylar (puan o zaman yatar) veya reddeder.
// Bir customer + program çifti için aynı anda en fazla 1 PENDING/APPROVED kayıt.
model LoyaltyClaim {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String
  programId     String
  proofImageUrl String // /uploads/... — yüklenen screenshot
  status        String         @default("PENDING") // PENDING | APPROVED | REJECTED
  rewardPoints  Int            @default(0) // Snapshot — admin onaylayınca verilecek puan
  adminNote     String? // Red sebebi vb.
  reviewedById  String? // User.id (staff, FK yok — admin silinse de kayıt kalsın)
  reviewedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  program       LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([customerId, programId])
  @@index([status, createdAt(sort: Desc)])
  @@index([tenantId])
}

// Müşterinin her programdaki ilerlemesi
model CustomerLoyaltyProgress {
  id         String @id @default(cuid())
  tenantId   String
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  programId  String

  // Programın türüne göre data formatı:
  // STAMP_CARD: { count: 5, target: 10, claimedRewards: 2 }
  // STREAK: { current: 3, longest: 7, lastDate: '2026-05-01' }
  // PRODUCT_VIP: { itemCounts: { 'item-x': 12, 'item-y': 5 } }
  // BIRTHDAY: { lastClaimedYear: 2025 }
  // WELCOME: { claimed: false }
  // MILESTONE: { lastClaimedAt: 5 } — son verilmiş milestone sipariş sayısı
  data Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  program  LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([customerId, programId])
  @@index([customerId])
  @@index([programId])
  @@index([tenantId])
}

// ==================== MOBILE: ADDRESSES, FAVORITES, PREFERENCES ====================

model Address {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId  String
  label       String // "Ev", "İş", "Yazlık"
  fullAddress String // Tam adres metni
  district    String? // İlçe
  city        String? // Şehir
  zipCode     String?
  latitude    Float? // Geo
  longitude   Float?
  notes       String? // Kapı kodu, kat vs.
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([tenantId])
}

model FavoriteItem {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  menuItemId String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // MenuItem'a soft-bağ: ürün silinirse favori de silinir

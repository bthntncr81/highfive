// HighFive Suite - Database Schema
// PostgreSQL with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== PLATFORM: TENANT / ABONELİK (OtOrder SaaS) ====================
// Platform-global modeller — tenantId TAŞIMAZLAR: Tenant, Plan, Subscription,
// StoredCard, BillingTransaction, User (kimlik), Membership (user↔tenant köprüsü).
// Geri kalan TÜM modeller tenant-owned'dır ve tenantId taşır (dbFor + RLS zorlar).

enum TenantStatus {
  TRIAL // deneme süresi
  ACTIVE // ödeme alındı, aktif
  PAST_DUE // ödeme başarısız — grace period
  SUSPENDED // askıya alındı (erişim 402)
}

model Tenant {
  id                    String       @id @default(cuid())
  name                  String // "Pizzacı Mehmet"
  subdomain             String       @unique // mehmet.otorder.com
  status                TenantStatus @default(TRIAL)
  // Onboarding sihirbazı ilerlemesi (WhatsappRestourant pattern'i)
  onboardingStep        Int          @default(0)
  onboardingCompletedAt DateTime?
  trialEndsAt           DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  memberships  Membership[]
  subscription Subscription?
  storedCards  StoredCard[]
  transactions BillingTransaction[]
  sessions     Session[]
  activityLogs ActivityLog[]

  locations                    Location[]
  tables                       Table[]
  categories                   Category[]
  menuItems                    MenuItem[]
  menuItemLocations            MenuItemLocation[]
  menuItemUpsells              MenuItemUpsell[]
  menuItemCrossSells           MenuItemCrossSell[]
  modifiers                    Modifier[]
  rawMaterials                 RawMaterial[]
  menuItemIngredients          MenuItemIngredient[]
  happyHours                   HappyHour[]
  happyHourItems               HappyHourItem[]
  orders                       Order[]
  orderItems                   OrderItem[]
  payments                     Payment[]
  invoices                     Invoice[]
  printers                     Printer[]
  printJobs                    PrintJob[]
  whatsAppMessages             WhatsAppMessage[]
  dailyReports                 DailyReport[]
  expenseCategories            ExpenseCategory[]
  expenses                     Expense[]
  settingses                   Settings[]
  analyticsEvents              AnalyticsEvent[]
  customers                    Customer[]
  loyaltyTiers                 LoyaltyTier[]
  pointsTransactions           PointsTransaction[]
  customerOrders               CustomerOrder[]
  campaigns                    Campaign[]
  bundleDeals                  BundleDeal[]
  bundleOptionGroups           BundleOptionGroup[]
  optionGroups                 OptionGroup[]
  optionGroupItems             OptionGroupItem[]
  bundleOptionGroupAssignments BundleOptionGroupAssignment[]
  bundleItems                  BundleItem[]
  coupons                      Coupon[]
  couponUsages                 CouponUsage[]
  integrationPartners          IntegrationPartner[]
  webhookLogs                  WebhookLog[]
  deviceTokens                 DeviceToken[]
  pushNotifications            PushNotification[]
  loyaltyPrograms              LoyaltyProgram[]
  loyaltyClaims                LoyaltyClaim[]
  customerLoyaltyProgresses    CustomerLoyaltyProgress[]
  addresses                    Address[]
  favoriteItems                FavoriteItem[]
  notificationPreferences      NotificationPreference[]
  spinWheelConfigs             SpinWheelConfig[]
  spinAttempts                 SpinAttempt[]
  achievements                 Achievement[]
  customerAchievements         CustomerAchievement[]
  scratchRewards               ScratchReward[]
  mysteryBoxConfigs            MysteryBoxConfig[]
  mysteryBoxOpens              MysteryBoxOpen[]
  builderBases                 BuilderBase[]
  builderIngredients           BuilderIngredient[]
  courierLocations             CourierLocation[]
  savedBuilderDesigns          SavedBuilderDesign[]
  pizzaGameScores              PizzaGameScore[]
}

// Paket tanımı — TABLO (enum değil): limitler/özellikler deploy'suz düzenlenebilir.
model Plan {
  id           String   @id @default(cuid())
  key          String   @unique // "STARTER" | "PRO" | "ENTERPRISE"
  name         String // "Başlangıç", "Pro", "Kurumsal"
  monthlyPrice Decimal  @db.Decimal(10, 2)
  annualPrice  Decimal  @db.Decimal(10, 2)
  maxLocations Int      @default(1) // -1 = sınırsız
  maxUsers     Int      @default(5) // -1 = sınırsız
  features     Json     @default("{}") // { loyalty:true, campaigns:true, analytics:true, whatsappLink:true, brandedApp:false, customLanding:false }
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

model Subscription {
  id       String             @id @default(cuid())
  tenantId String             @unique
  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId   String
  plan     Plan               @relation(fields: [planId], references: [id])
  status   SubscriptionStatus @default(TRIAL)
  cycle    BillingCycle       @default(MONTHLY)

  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  autoRenew          Boolean   @default(true)
  cancelledAt        DateTime?
  // Başarısız ödeme takibi (grace → askıya alma)
  failedAttempts     Int       @default(0)
  lastFailedAt       DateTime?

  // iyzico kart saklama referansları (platform hesabı)
  iyzicoCardUserKey String? // cardUserKey — tenant'ın iyzico'daki kart cüzdanı
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model StoredCard {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  iyzicoToken String // cardToken
  lastFour    String
  cardBrand   String? // VISA, MASTERCARD...
  cardHolder  String?
  expireMonth String
  expireYear  String
  isDefault   Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

enum BillingTransactionType {
  SUBSCRIPTION_PAYMENT
  SUBSCRIPTION_UPGRADE
  REFUND
  MANUAL_CREDIT // süper-admin hediye/manuel tanımlama
}

model BillingTransaction {
  id                   String                 @id @default(cuid())
  tenantId             String
  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type                 BillingTransactionType
  amount               Decimal                @db.Decimal(10, 2)
  currency             String                 @default("TRY")
  success              Boolean
  errorMessage         String?
  iyzicoPaymentId      String?
  iyzicoConversationId String?
  periodStart          DateTime?
  periodEnd            DateTime?
  createdAt            DateTime               @default(now())

  @@index([tenantId, createdAt])
}

// User↔Tenant köprüsü: rol/PIN/şube artık üyelikte (bir kişi birden çok
// restoranda farklı rollerle çalışabilir; PIN tenant içinde benzersizdir).
model Membership {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role       UserRole @default(WAITER)
  pin        String? // POS hızlı giriş — tenant içinde benzersiz
  locationId String? // Atandığı şube (opsiyonel)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, tenantId])
  @@unique([tenantId, pin])
  @@index([tenantId])
}

// ==================== LOCATION / BRANCH MANAGEMENT ====================

model Location {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String // "High Five Kadıköy"
  code              String // "kadiköy", "besiktas" — tenant içinde benzersiz (aşağıda)
  address           String?
  phone             String?
  email             String?
  timezone          String   @default("Europe/Istanbul")
  currency          String   @default("TRY")
  taxRate           Decimal  @default(10) @db.Decimal(5, 2)
  serviceCharge     Decimal  @default(0) @db.Decimal(5, 2) // Servis ücreti %
  serviceChargeType String   @default("PERCENTAGE") // PERCENTAGE, FIXED
  active            Boolean  @default(true)
  isDefault         Boolean  @default(false)
  settings          Json? // Location specific settings
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tables              Table[]
  orders              Order[]
  menuItems           MenuItemLocation[]
  happyHours          HappyHour[]
  integrationPartners IntegrationPartner[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

// ==================== USER MANAGEMENT ====================

enum UserRole {
  OWNER // Tenant sahibi — faturalama, abonelik, tenant ayarları, tema
  ADMIN
  MANAGER
  WAITER
  KITCHEN
  CASHIER
  COURIER
}

// PLATFORM KİMLİĞİ — tenantId TAŞIMAZ. Rol/PIN/şube Membership'te;
// bir kullanıcı birden çok tenant'ta (restoranda) üye olabilir.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  avatar    String?
  phone     String? // Kurye telefonu
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Kurye canlı durumu (kişi-seviyesi; yalnız COURIER üyeliği için anlamlı)
  isOnline    Boolean   @default(false)
  lastSeenLat Float?
  lastSeenLng Float?
  lastSeenAt  DateTime?

  memberships      Membership[]
  waiterOrders     Order[]           @relation("WaiterOrders")
  courierOrders    Order[]           @relation("CourierOrders")
  sessions         Session[]
  activityLogs     ActivityLog[]
  createdExpenses  Expense[]         @relation("ExpenseCreator")
  approvedExpenses Expense[]         @relation("ExpenseApprover")
  courierLocations CourierLocation[] @relation("CourierLocations")
  deviceTokens     DeviceToken[]
}

// Oturum tenant-damgalı (nullable: süper-admin oturumları tenant'sız olabilir)
model Session {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String?
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String?
  action    String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ==================== TABLE MANAGEMENT ====================

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
  CLEANING
}

model Table {
  id               String      @id @default(cuid())
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationId       String?
  number           Int
  name             String? // "Bahçe 1", "VIP 2" etc.
  capacity         Int         @default(4)
  status           TableStatus @default(FREE)
  positionX        Float? // For floor plan
  positionY        Float?
  floor            Int         @default(1)
  section          String? // "İç Mekan", "Bahçe", "Teras"
  active           Boolean     @default(true)
  mergedWithId     String? // Birleştirildiği ana masa
  sessionToken     String? // QR sipariş için oturum kodu
  sessionStartedAt DateTime? // Oturum başlangıç zamanı
  tabEnabled       Boolean     @default(true) // Hesap açık tutulabilir mi
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  location     Location? @relation(fields: [locationId], references: [id])
  orders       Order[]
  mergedWith   Table?    @relation("TableMerge", fields: [mergedWithId], references: [id])
  mergedTables Table[]   @relation("TableMerge")

  @@unique([tenantId, locationId, number])
  @@index([tenantId])
}

// ==================== MENU MANAGEMENT ====================

model Category {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  icon           String?
  image          String?
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  printToKitchen Boolean  @default(true) // false = İçecek gibi mutfağa düşmeyecek kategoriler
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items   MenuItem[]
  bundles BundleDeal[]

  @@index([tenantId])
}

// Alerjen Enum
enum Allergen {
  GLUTEN
  DAIRY
  EGGS
  FISH
  SHELLFISH
  NUTS
  PEANUTS
  SOY
  SESAME
  CELERY
  MUSTARD
  SULPHITES
  LUPIN
  MOLLUSCS
}

model MenuItem {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId  String
  name        String
  description String?
  price       Decimal    @db.Decimal(10, 2)
  image       String?
  badges      String[] // ["Popüler", "Yeni", "Acılı"]
  allergens   Allergen[] // Alerjen bilgileri
  calories    Int? // Kalori değeri
  prepTime    Int? // Preparation time in minutes

  // Stock Management
  available        Boolean   @default(true)
  outOfStockReason String? // "Malzeme bitti", "Bugünlük tükendi"
  outOfStockUntil  DateTime? // Otomatik açılma zamanı
  stockQuantity    Int? // Stok miktarı (opsiyonel)
  lowStockAlert    Int? // Düşük stok uyarı seviyesi

  // Sorting & Display
  sortOrder Int     @default(0)
  featured  Boolean @default(false) // Öne çıkan ürün

  // Pricing
  discountPrice Decimal?  @db.Decimal(10, 2) // İndirimli fiyat
  discountUntil DateTime? // İndirim bitiş tarihi

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category         Category             @relation(fields: [categoryId], references: [id])
  modifiers        Modifier[]
  ingredients      MenuItemIngredient[]
  orderItems       OrderItem[]
  upsellItems      MenuItemUpsell[]     @relation("UpsellFrom")
  upsoldBy         MenuItemUpsell[]     @relation("UpsellTo")
  crossSellItems   MenuItemCrossSell[]  @relation("CrossSellFrom")
  crossSoldBy      MenuItemCrossSell[]  @relation("CrossSellTo")
  locations        MenuItemLocation[]
  happyHourItems   HappyHourItem[]
  bundleItems      BundleItem[]
  optionGroupItems OptionGroupItem[]

  @@index([tenantId])
}

// Location-specific menu item settings
model MenuItemLocation {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menuItemId String
  locationId String
  available  Boolean  @default(true)
  price      Decimal? @db.Decimal(10, 2) // Location specific price override
  createdAt  DateTime @default(now())

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, locationId])
  @@index([tenantId])
}

// Upselling - "Bununla birlikte X de ister misiniz?"
model MenuItemUpsell {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromItemId     String
  toItemId       String
  message        String? // "Yanında patates ister misiniz?"
  discountAmount Decimal? @db.Decimal(10, 2) // Upsell indirimi
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  fromItem MenuItem @relation("UpsellFrom", fields: [fromItemId], references: [id], onDelete: Cascade)
  toItem   MenuItem @relation("UpsellTo", fields: [toItemId], references: [id], onDelete: Cascade)

  @@unique([fromItemId, toItemId])
  @@index([tenantId])
}

// Cross-selling - Sepette X varken Y öner
model MenuItemCrossSell {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromItemId     String
  toItemId       String
  message        String? // "Bunu da beğenebilirsiniz"
  discountAmount Decimal? @db.Decimal(10, 2)
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  fromItem MenuItem @relation("CrossSellFrom", fields: [fromItemId], references: [id], onDelete: Cascade)
  toItem   MenuItem @relation("CrossSellTo", fields: [toItemId], references: [id], onDelete: Cascade)

  @@unique([fromItemId, toItemId])
  @@index([tenantId])
}

model Modifier {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menuItemId String
  name       String // "Ekstra Peynir", "Acısız" etc.
  price      Decimal  @default(0) @db.Decimal(10, 2)
  available  Boolean  @default(true)
  createdAt  DateTime @default(now())

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ==================== RAW MATERIALS (HAM MADDE) ====================

enum RawMaterialUnit {
  GRAM
  KILOGRAM
  LITRE
  MILLILITRE
  ADET
  PORSIYON
}

model RawMaterial {
  id           String          @id @default(cuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String // tenant içinde benzersiz (model sonunda @@unique)
  unit         RawMaterialUnit @default(GRAM)
  currentStock Decimal         @default(0) @db.Decimal(10, 2) // Mevcut stok miktarı
  minStock     Decimal         @default(0) @db.Decimal(10, 2) // Min stok uyarı seviyesi
  costPerUnit  Decimal         @default(0) @db.Decimal(10, 2) // Birim maliyet
  supplier     String? // Tedarikçi
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  ingredients MenuItemIngredient[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// Menü ürünü - Ham madde ilişkisi (gramajlı)
model MenuItemIngredient {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menuItemId    String
  rawMaterialId String
  amount        Decimal  @db.Decimal(10, 2) // Miktar (gramaj)
  optional      Boolean  @default(false) // Çıkarılabilir mi (olmasın seçeneği)
  createdAt     DateTime @default(now())

  menuItem    MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, rawMaterialId])
  @@index([tenantId])
}

// Happy Hours - Zamanlı indirimler/menü değişiklikleri
model HappyHour {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationId  String?
  name        String // "Happy Hour", "Öğle Menüsü"
  description String?
  startTime   String // "17:00"
  endTime     String // "19:00"
  daysOfWeek  Int[] // [1,2,3,4,5] = Pazartesi-Cuma

  // İndirim Seçenekleri
  discountType    String? // "PERCENT", "FIXED", "CAMPAIGN"
  discountPercent Decimal? @db.Decimal(5, 2) // Yüzde indirim
  discountAmount  Decimal? @db.Decimal(10, 2) // Sabit tutar indirim
  campaignId      String? // Bağlı kampanya ID

  active    Boolean   @default(true)
  startDate DateTime? // Kampanya başlangıç
  endDate   DateTime? // Kampanya bitiş
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  location Location?       @relation(fields: [locationId], references: [id])
  campaign Campaign?       @relation(fields: [campaignId], references: [id])
  items    HappyHourItem[]

  @@index([tenantId])
}

model HappyHourItem {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  happyHourId     String
  menuItemId      String
  specialPrice    Decimal? @db.Decimal(10, 2) // Özel fiyat
  discountPercent Decimal? @db.Decimal(5, 2) // veya % indirim
  createdAt       DateTime @default(now())

  happyHour HappyHour @relation(fields: [happyHourId], references: [id], onDelete: Cascade)
  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([happyHourId, menuItemId])
  @@index([tenantId])
}

// ==================== ORDER MANAGEMENT ====================

enum OrderStatus {
  PENDING // Just created
  CONFIRMED // Confirmed by kitchen
  PREPARING // Being prepared
  READY // Ready for service
  OUT_FOR_DELIVERY // Kurye yolda (delivery orders)
  DELIVERED // Teslim edildi
  SERVED // Served to customer (dine-in)
  COMPLETED // Paid and closed
  CANCELLED // Cancelled
}

enum OrderType {
  DINE_IN // Table order
  TAKEAWAY // Paket
  DELIVERY // Eve servis (kurye ile)
  ROOM_SERVICE // Oda servisi (otel)
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  ONLINE
  MULTINET
  SODEXO
  TICKET
  TAB // Hesaba ekle (sonra öde)
  DIGITAL_COIN // Festival için dijital coin
  OTHER
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
  ON_TAB // Hesap açık
}

model Order {
  id                String         @id @default(cuid())
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderNumber       Int            @default(autoincrement()) // global sequence; tenant içinde benzersiz (model sonunda) — Faz 4'te per-tenant sayaç güzelleştirmesi
  locationId        String?
  tableId           String?
  userId            String? // Waiter who created the order
  courierId         String? // Kurye ID
  customerName      String?
  customerPhone     String?
  customerEmail     String?
  customerAddress   String? // Teslimat adresi
  customerLatitude  Float? // Mobile sipariş için GPS (Google Maps linki)
  customerLongitude Float?
  roomNumber        String? // Otel oda numarası
  type              OrderType      @default(DINE_IN)
  status            OrderStatus    @default(PENDING)
  paymentStatus     PaymentStatus  @default(PENDING)
  paymentMethod     PaymentMethod?

  // Pricing
  subtotal      Decimal @db.Decimal(10, 2)
  tax           Decimal @default(0) @db.Decimal(10, 2)
  serviceCharge Decimal @default(0) @db.Decimal(10, 2) // Servis ücreti
  deliveryFee   Decimal @default(0) @db.Decimal(10, 2) // Kurye ücreti
  discount      Decimal @default(0) @db.Decimal(10, 2)
  total         Decimal @db.Decimal(10, 2)
  tip           Decimal @default(0) @db.Decimal(10, 2)

  // Tab (Sonradan ödeme) settings
  isTab       Boolean   @default(false) // Hesap açık mı
  tabClosedAt DateTime? // Hesap ne zaman kapandı

  // Kurye bilgileri
  assignedAt        DateTime? // Kuryeye atanma zamanı (admin/POS tarafından)
  courierAcceptedAt DateTime? // Kurye "Aldım"a basma zamanı
  pickedUpAt        DateTime? // Yola çıkma zamanı
  deliveredAt       DateTime? // Teslim zamanı
  deliveryPhotoUrl  String? // Teslimat anı kanıt fotoğrafı
  deliveryNotes     String? // Kurye notu (kapı çalmıyor, eline verildi vb.)

  notes           String?
  source          String? // "POS", "WhatsApp", "Web", "QR"
  externalOrderId String? // Dış sistem sipariş ID (WhatRes vb.)

  // Analytics
  deviceType String? // "mobile", "tablet", "desktop"
  userAgent  String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  location Location?   @relation(fields: [locationId], references: [id])
  table    Table?      @relation(fields: [tableId], references: [id])
  user     User?       @relation("WaiterOrders", fields: [userId], references: [id])
  courier  User?       @relation("CourierOrders", fields: [courierId], references: [id])
  items    OrderItem[]
  invoice  Invoice?
  payments Payment[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
}

model OrderItem {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId      String
  menuItemId   String?
  menuItemName String? // Preserved name when menu item is deleted
  quantity     Int         @default(1)
  paidQuantity Int         @default(0) // Ödenen miktar
  unitPrice    Decimal     @db.Decimal(10, 2)
  total        Decimal     @db.Decimal(10, 2)
  notes        String?
  modifiers    String[] // Applied modifier names
  status       OrderStatus @default(PENDING)
  isUpsell     Boolean     @default(false) // Upsell'den mi geldi
  isCrossSell  Boolean     @default(false) // Cross-sell'den mi geldi
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

// ==================== PAYMENT & INVOICING ====================

model Payment {
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId    String
  amount     Decimal       @db.Decimal(10, 2)
  tipAmount  Decimal       @default(0) @db.Decimal(10, 2) // Bahşiş miktarı
  method     PaymentMethod
  reference  String? // Transaction ID, etc.
  paidItems  Json? // { itemId: quantity } hangi ürünlerden kaç adet ödendi
  refunded   Boolean       @default(false)
  refundedAt DateTime?
  refundedBy String? // User ID who refunded
  createdAt  DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Invoice {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId       String   @unique
  invoiceNumber String // tenant içinde benzersiz (model sonunda @@unique)
  customerName  String?
  customerTaxId String?
  subtotal      Decimal  @db.Decimal(10, 2)
  tax           Decimal  @db.Decimal(10, 2)
  serviceCharge Decimal  @default(0) @db.Decimal(10, 2)
  tip           Decimal  @default(0) @db.Decimal(10, 2)
  total         Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
}

// ==================== PRINTER MANAGEMENT ====================

enum PrinterType {
  RECEIPT // Fiş yazıcı
  KITCHEN // Mutfak yazıcı
  BAR // Bar yazıcı
  LABEL // Etiket yazıcı
}

model Printer {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String // "Mutfak Yazıcı 1"
  type         PrinterType @default(RECEIPT)
  ipAddress    String? // Network printer
  port         Int         @default(9100)
  usbVendorId  String? // USB printer
  usbProductId String?
  paperWidth   Int         @default(80) // 80mm, 58mm
  active       Boolean     @default(true)
  isDefault    Boolean     @default(false)
  categories   String[] // Hangi kategorileri basar
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([tenantId])
}

model PrintJob {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  printerId String
  orderId   String?
  content   String // Print content (ESC/POS commands or text)
  status    String    @default("PENDING") // PENDING, PRINTING, COMPLETED, FAILED
  error     String?
  createdAt DateTime  @default(now())
  printedAt DateTime?

  @@index([tenantId])
}

// ==================== WHATSAPP INTEGRATION ====================

model WhatsAppMessage {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messageId String   @unique // WhatsApp message ID
  from      String // Phone number
  body      String
  timestamp DateTime
  processed Boolean  @default(false)
  orderId   String? // If converted to order
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// ==================== REPORTING ====================

model DailyReport {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationId          String?
  date                DateTime @db.Date
  totalOrders         Int      @default(0)
  totalRevenue        Decimal  @default(0) @db.Decimal(10, 2)
  cashAmount          Decimal  @default(0) @db.Decimal(10, 2)
  cardAmount          Decimal  @default(0) @db.Decimal(10, 2)
  onlineAmount        Decimal  @default(0) @db.Decimal(10, 2)
  tipAmount           Decimal  @default(0) @db.Decimal(10, 2)
  serviceChargeAmount Decimal  @default(0) @db.Decimal(10, 2)
  otherAmount         Decimal  @default(0) @db.Decimal(10, 2)
  cancelCount         Int      @default(0)
  avgOrderTime        Int? // in minutes
  avgOrderValue       Decimal? @db.Decimal(10, 2)
  customerCount       Int      @default(0)
  topItems            Json? // [{ itemId, name, count, revenue }]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([tenantId, locationId, date])
  @@index([tenantId])
}

// ==================== EXPENSES (GİDERLER) ====================

enum ExpenseStatus {
  PENDING_APPROVAL // Büyük gider — admin onayı bekliyor (auto-approve threshold üzerinde)
  APPROVED // Onaylandı (varsayılan: küçük giderler oto onaylı; ADMIN/MANAGER hep oto)
  REJECTED // Reddedildi
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String // tenant içinde benzersiz (model sonunda @@unique)
  icon      String? // emoji veya icon adı
  color     String? // #hex (UI badge)
  isSystem  Boolean  @default(false) // seed'den geldiyse silinemez
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Expense {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(10, 2)
  categoryId    String
  description   String?
  expenseDate   DateTime      @db.Date // Giderin oluştuğu tarih (filtre için)
  vendor        String? // "Kimden": BEDAŞ, Migros, vs.
  paymentMethod PaymentMethod @default(CASH) // Mevcut enum
  receiptUrl    String? // Fiş foto — /api/upload'dan dönen path
  notes         String? // Uzun not / detay
  status        ExpenseStatus @default(APPROVED)

  // Kim ekledi / kim onayladı
  createdById  String
  approvedById String?
  approvedAt   DateTime?

  locationId String? // Multi-location için (back-relation eklenmedi, query'lerde filter kullanılır)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category   ExpenseCategory @relation(fields: [categoryId], references: [id])
  createdBy  User            @relation("ExpenseCreator", fields: [createdById], references: [id])
  approvedBy User?           @relation("ExpenseApprover", fields: [approvedById], references: [id])

  @@index([expenseDate])
  @@index([categoryId])
  @@index([createdById])
  @@index([status])
  @@index([locationId, expenseDate])
  @@index([tenantId])
}

// ==================== SETTINGS ====================

model Settings {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String // tenant içinde benzersiz (model sonunda @@unique)
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

// ==================== ANALYTICS ====================

model AnalyticsEvent {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationId String?
  eventType  String // "page_view", "add_to_cart", "order_completed", "upsell_accepted"
  eventData  Json?
  sessionId  String?
  deviceType String?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
}

// ==================== LOYALTY PROGRAM ====================

// Sadakat Programı Müşterisi
model Customer {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phone     String? // Eskiden zorunluydu — email-OTP geçişiyle opsiyonel; tenant içinde benzersiz
  email     String? // Email-OTP login için ana identifier; tenant içinde benzersiz
  name      String?
  birthDate DateTime?
  gender    String? // "MALE" | "FEMALE" | "OTHER" — kayıtta opsiyonel
  password  String? // Optional - eski web login (kullanılmıyor)

  // Loyalty Info
  loyaltyTierId  String?
  totalPoints    Int     @default(0)
  lifetimePoints Int     @default(0) // Toplam kazanılan puan
  totalSpent     Decimal @default(0) @db.Decimal(10, 2) // Toplam harcama
  orderCount     Int     @default(0) // Sipariş sayısı

  // Marketing
  smsConsent   Boolean @default(false)
  emailConsent Boolean @default(false)
  pushConsent  Boolean @default(false)

  // KVKK / Sözleşme Audit (yasal uyum için kabul tarihleri)
  termsAcceptedAt    DateTime? // Üyelik sözleşmesi kabul tarihi
  kvkkAcceptedAt     DateTime? // KVKK aydınlatma metni kabul tarihi
  marketingConsentAt DateTime? // Açık pazarlama izni (e-posta + SMS) — KVKK gerek

  // Status
  isActive                  Boolean   @default(true)
  isVerified                Boolean   @default(false) // Email doğrulandı mı
  verificationCode          String?
  verificationCodeExpiresAt DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastOrderAt   DateTime?
  // Win-back kampanyası — son gönderim tarihi (cooldown için)
  lastWinbackAt DateTime?
  // Spin wheel — günde 1x cooldown için
  lastSpinAt    DateTime?

  loyaltyTier     LoyaltyTier? @relation(fields: [loyaltyTierId], references: [id])
  // Cashback bakiyesi (TL cinsinden — 1 cashback unit = 1 TL)
  cashbackBalance Decimal      @default(0) @db.Decimal(10, 2)
  // Davet (referral) sistemi
  referralCode    String? // Kişiye özel davet kodu; tenant içinde benzersiz
  referredByCode  String? // Bu müşteri hangi koddan geldi
  referralCount   Int          @default(0) // Bu müşteri kaç kişi davet etti
  // Streak takibi
  currentStreak   Int          @default(0)
  longestStreak   Int          @default(0)
  lastStreakDate  DateTime?

  orders              CustomerOrder[]
  pointsHistory       PointsTransaction[]
  usedCoupons         CouponUsage[]
  devices             DeviceToken[]
  addresses           Address[]
  favorites           FavoriteItem[]
  notificationPrefs   NotificationPreference?
  loyaltyProgress     CustomerLoyaltyProgress[]
  // Gamification
  spinAttempts        SpinAttempt[]
  achievements        CustomerAchievement[]
  scratchRewards      ScratchReward[]
  mysteryBoxOpens     MysteryBoxOpen[]
  // "Kendin Tasarla" — kaydedilmiş özel pizza/sandviç tasarımları (üye-özel)
  savedBuilderDesigns SavedBuilderDesign[]
  // Google review / Instagram story gibi screenshot-onaylı ödül talepleri
  loyaltyClaims       LoyaltyClaim[]

  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@unique([tenantId, referralCode])
  @@index([phone])
  @@index([email])
  @@index([referralCode])
  @@index([tenantId])
}

// Sadakat Seviyesi (Bronze, Silver, Gold vb.)
model LoyaltyTier {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String // "Bronze", "Silver", "Gold", "Platinum"
  minPoints        Int // Bu seviyeye ulaşmak için gereken min puan
  pointsMultiplier Decimal  @default(1) @db.Decimal(3, 2) // Puan çarpanı (1.5x = %50 daha fazla puan)
  discountPercent  Decimal  @default(0) @db.Decimal(5, 2) // Sabit % indirim
  benefits         Json? // Ek avantajlar listesi
  color            String? // Badge rengi (#CD7F32 = bronze)
  icon             String? // Emoji veya icon
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customers Customer[]

  @@index([tenantId])
}

// Puan İşlemleri
model PointsTransaction {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId  String
  orderId     String?
  points      Int // + kazanım, - harcama
  type        String // "EARN", "SPEND", "BONUS", "EXPIRE", "ADJUSTMENT"
  description String? // "Sipariş #123", "10 siparişe özel 100 puan"
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Müşteri Siparişleri (Order'a referans)
model CustomerOrder {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId   String
  orderId      String   @unique
  pointsEarned Int      @default(0)
  pointsSpent  Int      @default(0)
  createdAt    DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ==================== CAMPAIGNS & PROMOTIONS ====================

// İndirim Kampanyaları
model Campaign {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  image       String? // Kapak fotoğrafı URL — landing/mobile kampanya kartlarında gösterilir
  type        String // "DISCOUNT", "BOGO", "FREE_ITEM", "POINTS_MULTIPLIER", "MIN_PURCHASE"

  // Koşullar
  minPurchase     Decimal? @db.Decimal(10, 2) // Min sepet tutarı
  minItems        Int? // Min ürün sayısı
  loyaltyTierIds  String[] // Hangi üyelik seviyeleri için geçerli
  applicableItems String[] // Geçerli ürün ID'leri (boş = hepsi)
  excludedItems   String[] // Hariç tutulan ürünler

  // İndirim
  discountType  String? // "PERCENT", "FIXED", "FREE_ITEM"
  discountValue Decimal? @db.Decimal(10, 2) // % veya sabit tutar
  freeItemId    String? // Bedava verilecek ürün
  maxDiscount   Decimal? @db.Decimal(10, 2) // Max indirim limiti

  // Geçerlilik
  startDate  DateTime
  endDate    DateTime
  daysOfWeek Int[] // 0-6 (boş = her gün)
  startTime  String? // "10:00"
  endTime    String? // "22:00"

  // Limitleme
  usageLimit       Int? // Toplam kullanım limiti
  usagePerCustomer Int? // Kişi başı limit
  currentUsage     Int  @default(0)

  // Status
  isActive  Boolean @default(true)
  autoApply Boolean @default(false) // Otomatik uygulan mı
  stackable Boolean @default(false) // Diğer kampanyalarla birleştirilebilir mi

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  happyHours        HappyHour[] // Bu kampanyayı kullanan happy hour'lar
  pushNotifications PushNotification[]

  @@index([tenantId])
}

// Paket Menüler / Combo'lar
model BundleDeal {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String // "Aile Paketi", "Öğle Menüsü"
  description String?
  image       String?

  // Fiyatlandırma
  originalPrice Decimal @db.Decimal(10, 2) // Normal toplam fiyat
  bundlePrice   Decimal @db.Decimal(10, 2) // Paket fiyatı
  savings       Decimal @db.Decimal(10, 2) // Tasarruf miktarı

  // Geçerlilik
  startDate  DateTime?
  endDate    DateTime?
  daysOfWeek Int[] // Hangi günler geçerli
  startTime  String?
  endTime    String?

  // Status
  isActive  Boolean @default(true)
  featured  Boolean @default(false) // Öne çıkan mı
  sortOrder Int     @default(0)

  // Kategori — paket'in menüde hangi başlık altında görüneceği.
  // null ise "Paket Menüler" default başlığı altında görünür.
  categoryId String?

  // Analytics
  soldCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  items                  BundleItem[]
  optionGroups           BundleOptionGroup[]
  optionGroupAssignments BundleOptionGroupAssignment[]

  @@index([tenantId])
}

// Müşterinin paket içinde seçim yapacağı gruplar.
// Örn: "Pizza Seçimi" — pickCount=2, categoryId=Pizza, priceMode=INCLUDED
//      "Yan Ürün"   — pickCount=1, eligibleItemIds=[..], priceMode=ADD_PRICE
model BundleOptionGroup {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bundleId        String
  name            String // "Pizza Seçimi"
  pickCount       Int      @default(1) // Müşteri kaç tane seçecek
  // priceMode: INCLUDED = paket fiyatına dahil (seçim sadece çeşni)
  //            ADD_PRICE = seçilen ürünün menü fiyatı pakete eklenir
  priceMode       String   @default("INCLUDED")
  // Eligibility — yalnızca biri kullanılır:
  //   categoryId set ise → o kategorideki tüm aktif ürünler seçilebilir
  //   eligibleItemIds dolu ise → sadece bu menü item'ları
  categoryId      String?
  eligibleItemIds String[]
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  bundle BundleDeal @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ==================== REUSABLE OPTION GROUPS ====================
// Pizza Seçimi gibi opsiyon grupları — bir kez tanımlanır, birden çok bundle'a atanır.
// Her grup içindeki ürünlerin kendi ek fiyatı (extraPrice) olabilir.
model OptionGroup {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String // "Pizza Seçimi", "İçecek Seçimi", "Yan Ürün"
  description String?
  minSelect   Int      @default(1) // En az kaç ürün seçilmeli
  maxSelect   Int      @default(1) // En fazla kaç ürün seçilebilir
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       OptionGroupItem[]
  assignments BundleOptionGroupAssignment[]

  @@index([tenantId])
}

// Grup içindeki ürünler — her birinin ek fiyatı olabilir
model OptionGroupItem {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  optionGroupId String
  menuItemId    String
  extraPrice    Decimal  @default(0) @db.Decimal(10, 2) // 0 = pakete dahil, >0 = ek ücret
  sortOrder     Int      @default(0)
  isDefault     Boolean  @default(false) // Otomatik seçili gelen (opsiyonel)
  createdAt     DateTime @default(now())

  optionGroup OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  menuItem    MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([optionGroupId, menuItemId])
  @@index([tenantId])
}

// Bundle ↔ OptionGroup ilişki tablosu (many-to-many)
model BundleOptionGroupAssignment {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bundleId      String
  optionGroupId String
  // Aynı grup bir bundle'a kaç defa eklendi (kaç slot oluşacak).
  // Örn: "Pizza Seçimi" grubunu quantity=2 atayınca müşteri 2 ayrı pizza seçer.
  quantity      Int      @default(1)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  bundle      BundleDeal  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  optionGroup OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@unique([bundleId, optionGroupId])
  @@index([tenantId])
}

// Paket İçindeki Ürünler
model BundleItem {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bundleId    String
  menuItemId  String
  quantity    Int      @default(1)
  isOptional  Boolean  @default(false) // Seçimli mi
  optionGroup String? // "Ana Yemek", "İçecek" - aynı grup içinden seç
  createdAt   DateTime @default(now())

  bundle   BundleDeal @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  menuItem MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([bundleId, menuItemId])
  @@index([tenantId])
}

// Kuponlar
model Coupon {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String // "HOSGELDIN20", "DOGUMGUNU50" — tenant içinde benzersiz
  name        String
  description String?

  // İndirim
  discountType  String // "PERCENT", "FIXED"
  discountValue Decimal  @db.Decimal(10, 2)
  maxDiscount   Decimal? @db.Decimal(10, 2)
  minPurchase   Decimal? @db.Decimal(10, 2)

  // Geçerlilik
  startDate DateTime
  endDate   DateTime

  // Limitleme
  usageLimit       Int? // Toplam kullanım
  usagePerCustomer Int  @default(1) // Kişi başı
  currentUsage     Int  @default(0)

  // Hedef kitle
  loyaltyTierIds String[] // Hangi üyelik seviyeleri
  isFirstOrder   Boolean  @default(false) // Sadece ilk sipariş için

  // Status
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usages          CouponUsage[]
  // Gamification back-relations
  spinAttempts    SpinAttempt[]
  scratchRewards  ScratchReward[]  @relation("ScratchCoupon")
  mysteryBoxOpens MysteryBoxOpen[] @relation("MysteryBoxCoupon")

  @@unique([tenantId, code])
  @@index([tenantId])
}

// Kupon Kullanımları
model CouponUsage {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  couponId   String
  customerId String?
  orderId    String
  discount   Decimal  @db.Decimal(10, 2) // Uygulanan indirim
  createdAt  DateTime @default(now())

  coupon   Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([tenantId])
}

// ==================== EXTERNAL INTEGRATION ====================

model IntegrationPartner {

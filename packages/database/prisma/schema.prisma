  customer Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  config   MysteryBoxConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  coupon   Coupon?          @relation(fields: [couponId], references: [id], onDelete: SetNull, name: "MysteryBoxCoupon")

  @@index([customerId, createdAt])
  @@index([tenantId])
}

// ============================================================================
// PIZZA & SANDWICH BUILDER — kullanıcı kendi pizzasını/sandviçini oluşturur
// ============================================================================
// 2D layered görselle live preview: base'in üstüne her ingredient'in transparent
// layerImage'ı stack edilir. Her ingredient extraPrice ile temel fiyata eklenir.

enum BuilderType {
  PIZZA
  SANDWICH
}

enum IngredientCategory {
  DOUGH // Hamur (pizza) / Ekmek (sandviç) - opsiyonel ekstra topping
  BASE_SAUCE // Taban sosu (domates, beyaz, BBQ taban, mayonez)
  CHEESE // Peynir
  MEAT // Et / Sucuk / Pepperoni
  VEGETABLE // Sebze / Mantar
  TOP_SAUCE // Üst sos / drizzle (BBQ, pesto, sweet chili, trüflü)
  SAUCE // Genel sos (legacy — backward compat, kullanılmaz)
  EXTRA // Extra (özel toppings)
}

// Taban / kabuk: ince hamur pizza, kalın hamur, beyaz ekmek sandviç vs.
model BuilderBase {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        BuilderType
  name        String // "İnce Hamur Pizza", "Beyaz Ekmek Sandviç"
  description String?
  basePrice   Decimal     @db.Decimal(10, 2)
  // Live preview için temel görsel (pizza/sandviç dilimi, transparent dışı)
  baseImage   String
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([tenantId])
}

// Malzemeler — her biri layerImage ile pizza/sandviç üzerine binebilir.
model BuilderIngredient {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Hangi tip ürünlere uygulanabilir? (PIZZA, SANDWICH; BOTH için 2 ayrı kayıt önerilir)
  type        BuilderType
  category    IngredientCategory
  name        String // "Sucuk", "Mozzarella", "Domates"
  description String?
  // Müşteri seçince temel fiyata eklenecek tutar
  extraPrice  Decimal            @default(0) @db.Decimal(10, 2)
  // 2D katman görseli (transparent PNG/SVG)
  layerImage  String
  // Stack sırası: küçük = altta, büyük = üstte (sos genelde 1, peynir 5, et 7)
  layerOrder  Int                @default(0)
  sortOrder   Int                @default(0)
  isActive    Boolean            @default(true)
  // Kalori/alerjen bilgisi opsiyonel
  calories    Int?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([type, category, isActive])
  @@index([tenantId])
}

// ==================== COURIER LOCATION TRACKING ====================
// Kuryenin canlı/tarihsel konum geçmişi.
// 5sn (foreground) / 30sn (background) aralıklarla insert edilir.
// 24 saatten eski kayıtlar daily cron ile temizlenir.

model CourierLocation {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courierId    String
  latitude     Float
  longitude    Float
  accuracy     Float? // metre
  heading      Float? // 0-360 derece
  speed        Float? // m/s
  altitude     Float?
  batteryLevel Int? // %
  isMoving     Boolean  @default(true)
  source       String   @default("FOREGROUND") // FOREGROUND | BACKGROUND
  createdAt    DateTime @default(now())

  courier User @relation("CourierLocations", fields: [courierId], references: [id], onDelete: Cascade)

  @@index([courierId, createdAt(sort: Desc)])
  @@index([createdAt]) // TTL cleanup
  @@index([tenantId])
}

// Müşterinin "Kendin Tasarla" ile oluşturduğu pizza/sandviç tasarımını kaydet,
// sonradan tek tıkla tekrar sipariş et. Üye-özel. baseId + ingredientIds başka
// tablolara referans — burada FK YOK ki taban/malzeme silinse bile tasarım
// kalsın (UI "bu malzeme artık aktif değil" gösterir).
model SavedBuilderDesign {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String
  name          String // Kullanıcının verdiği isim: "Acılı Karışık Pizza"
  builderType   BuilderType
  baseId        String // BuilderBase.id snapshot
  ingredientIds String[] // BuilderIngredient.id'leri (sıralı)
  totalPrice    Decimal     @db.Decimal(10, 2) // Kayıt anındaki fiyat (server re-validate eder)
  createdAt     DateTime    @default(now())
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt(sort: Desc)])
  @@index([tenantId])
}

// Pizza Şefi mini-oyunu — herkese açık global skor tablosu
model PizzaGameScore {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  score     Int
  createdAt DateTime @default(now())

  @@index([score])
  @@index([tenantId])
}

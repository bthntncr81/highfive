model MysteryBoxOpen {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId  String
  configId    String
  pointsSpent Int
  prizeIndex  Int
  prizeLabel  String
  prizeType   String // DISCOUNT_PERCENT, POINTS, FREE_ITEM, NOTHING
  prizeValue  Decimal? @db.Decimal(10, 2)
  couponId    String?

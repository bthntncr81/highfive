# API Dockerfile
FROM node:20-alpine

WORKDIR /app

# Install necessary packages
RUN apk add --no-cache openssl

# Copy package files
COPY package*.json ./

# Install root dependencies
RUN npm install

# Copy Prisma schema and generate client
COPY packages/database/prisma ./packages/database/prisma
COPY packages/database/package*.json ./packages/database/
RUN cd packages/database && npm install && npx prisma generate

# Copy API source code
COPY apps/api ./apps/api
COPY tsconfig.base.json ./

# Fix tsconfig + jsonwebtoken types
RUN node -e "const f=require('fs'); \
  const b=JSON.parse(f.readFileSync('tsconfig.base.json')); \
  b.compilerOptions.rootDir='.';b.compilerOptions.module='commonjs';b.compilerOptions.moduleResolution='node';b.compilerOptions.noEmitOnError=false;delete b.compilerOptions.customConditions;delete b.compilerOptions.composite;delete b.compilerOptions.declarationMap;delete b.compilerOptions.emitDeclarationOnly; \
  f.writeFileSync('tsconfig.base.json',JSON.stringify(b,null,2)); \
  const a=JSON.parse(f.readFileSync('apps/api/tsconfig.app.json')); \
  delete a.compilerOptions.rootDir; \
  f.writeFileSync('apps/api/tsconfig.app.json',JSON.stringify(a,null,2));" && \
    mkdir -p node_modules/@types/jsonwebtoken && \
    echo 'declare module "jsonwebtoken" { function sign(p:any,s:any,o?:any):string; function verify(t:string,s:any,o?:any):any; function decode(t:string,o?:any):any; export {sign,verify,decode}; export default {sign,verify,decode}; }' > node_modules/@types/jsonwebtoken/index.d.ts && \
    echo '{"name":"@types/jsonwebtoken","version":"9.0.0","types":"index.d.ts"}' > node_modules/@types/jsonwebtoken/package.json

# Install nodemailer in separate dir to avoid rootDir issues
RUN mkdir -p /tmp/nm && cd /tmp/nm && npm init -y 2>/dev/null && npm install nodemailer

# Install nodemailer for email notifications (after source copy)
RUN npm install --no-save --ignore-scripts nodemailer 2>/dev/null; true

# Create uploads directory
RUN mkdir -p /app/uploads

# Expose port
EXPOSE 3000

# Environment
ENV NODE_ENV=production

# Start command - push schema and start server
CMD sh -c "cd packages/database && npx prisma db push --skip-generate && cd /app && npx ts-node -P apps/api/tsconfig.app.json apps/api/src/main.ts"

# API Dockerfile
FROM node:20-alpine

WORKDIR /app

# Install necessary packages
RUN apk add --no-cache openssl

# Copy package files
COPY package*.json ./

# Install root dependencies + nodemailer for email notifications
RUN npm install && npm install nodemailer

# Copy Prisma schema and generate client
COPY packages/database/prisma ./packages/database/prisma
COPY packages/database/package*.json ./packages/database/
RUN cd packages/database && npm install && npx prisma generate

# Copy API source code
COPY apps/api ./apps/api
COPY tsconfig.base.json ./

# Create uploads directory
RUN mkdir -p /app/uploads

# Expose port
EXPOSE 3000

# Environment
ENV NODE_ENV=production

# Start command - push schema and start server
CMD sh -c "cd packages/database && npx prisma db push --skip-generate && cd /app && npx ts-node apps/api/src/main.ts"
